{
  "expo": {
    "name": "Envy",
    "slug": "envy",
    "scheme": "envy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/absolute-cinema.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.envy",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.envy"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/absolute-cinema.png",
      "name": "Envy",
      "shortName": "Envy",
      "themeColor": "#0B0B0F",
      "backgroundColor": "#0B0B0F"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ],
    "backgroundColor": "#0B0B0F"
  }
}
